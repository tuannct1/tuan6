<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".bai2.MainActivity"
    android:orientation="vertical"
    android:gravity="center_horizontal">>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStart="0dp"
        app:backgroundTint="#FF0000">
        <RelativeLayout
            android:id="@+id/tbstart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CA4242"
            android:visibility="visible"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:src="@drawable/select_multiple_svgrepo_com"
                android:layout_alignParentEnd="true"
                />
            <ImageView
                android:id="@+id/search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:src="@drawable/search_svgrepo_com"
                android:layout_toStartOf="@+id/select"
                />
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/tbsearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CA4242"
            android:visibility="gone"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/cancel2"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:src="@drawable/cancel_svgrepo_com"
                />
            <AutoCompleteTextView
                android:id="@+id/editSearch"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/cancel2"
                android:completionThreshold="1"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/tbselect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CA4242"
            android:visibility="gone"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:src="@drawable/cancel_svgrepo_com"
                android:layout_alignParentStart="true"
                />
            <TextView
                android:id="@+id/tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 selected"
                android:textColor="#000"
                android:layout_marginStart="16dp"
                android:textSize="30sp"
                android:layout_toEndOf="@+id/cancel"/>
            <ImageView
                android:id="@+id/selectall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:src="@drawable/select_all_svgrepo_com"
                android:layout_alignParentEnd="true"
                />
            <ImageView
                android:id="@+id/bin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:src="@drawable/bin_svgrepo_com"
                android:layout_toStartOf="@+id/selectall"
                />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <Button
        android:id="@+id/btnThem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thêm sinh viên"
        android:backgroundTint="#4CAF50"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>